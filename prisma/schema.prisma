generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// Enums
// ============================================================

enum UserRole {
  BUYER
  SELLER
  DELIVERY
  ADMIN
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DeliveryStatus {
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  NEAR_LOCATION
  DELIVERED
  FAILED
}

enum TransactionType {
  PURCHASE
  EARNING
  WITHDRAWAL
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum NotificationType {
  ORDER
  DELIVERY
  PAYMENT
  SYSTEM
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  PICKED_UP
  INSPECTING
  COMPLETED
  CANCELLED
}

enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum StockTransferStatus {
  PENDING
  APPROVED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum BannerPosition {
  HERO
  SIDEBAR
  FOOTER
  POPUP
}

// ============================================================
// Models
// ============================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  role      UserRole @default(BUYER)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  companyId String? @unique

  // Relations
  company       Company? @relation("CompanyAccount")
  seller        Seller?
  orders        Order[]
  deliveries    Delivery[]
  transactions  Transaction[]
  notifications Notification[]
  reviews       Review[]
  buyerReturns  ReturnRequest[] @relation("BuyerReturns")
  sellerReturns ReturnRequest[] @relation("SellerReturns")
  usedCoupons   UsedCoupon[] @relation("UsedCoupons")
  addresses     Address[]    @relation("UserAddresses")
  auditLogs     AuditLog[]
}

model Seller {
  id             String   @id @default(cuid())
  userId         String   @unique
  storeName      String
  storeSlug      String   @unique
  storeDescription String?
  storeLogo      String?
  rating         Float    @default(0)
  totalSales     Int      @default(0)
  isVerified     Boolean  @default(false)
  commissionRate Float    @default(0.1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id])
  products Product[]
  orderItems OrderItem[]
  wallet   Wallet?
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  image       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  products Product[]
}

model Product {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  description  String
  price        Float
  originalPrice Float?
  image        String
  images       String?
  rating       Float         @default(4.5)
  reviewCount  Int           @default(0)
  stock        Int           @default(100)
  featured     Boolean       @default(false)
  categoryId   String
  sellerId     String
  status       ProductStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  category    Category @relation(fields: [categoryId], references: [id])
  seller      Seller   @relation(fields: [sellerId], references: [id])
  orderItems  OrderItem[]
  reviews     Review[]
  inventory   InventoryItem[]
  flashSales  FlashSale[]
  stockTransfers StockTransfer[]
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  buyerId         String
  status          OrderStatus   @default(PENDING)
  totalAmount     Float
  platformFee     Float         @default(0)
  sellerEarnings  Float         @default(0)
  deliveryFee     Float         @default(0)
  companyId       String?
  poNumber        String?
  shippingAddress String
  paymentStatus   PaymentStatus @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  buyer      User          @relation(fields: [buyerId], references: [id])
  company    Company?      @relation(fields: [companyId], references: [id])
  orderItems OrderItem[]
  delivery   Delivery?
  transactions Transaction[]
  returns    ReturnRequest[]
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  quantity      Int
  price         Float
  sellerId      String
  sellerEarnings Float  @default(0)
  status        String  @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  order         Order           @relation(fields: [orderId], references: [id])
  product       Product         @relation(fields: [productId], references: [id])
  seller        Seller          @relation(fields: [sellerId], references: [id])
  returnRequest ReturnRequest?
}

model Delivery {
  id               String         @id @default(cuid())
  orderId          String         @unique
  deliveryPersonId String?
  status           DeliveryStatus @default(ASSIGNED)
  pickupOtp        String?
  deliveryOtp      String?
  proofPhotoUrl    String?
  proofSignatureUrl String?
  deliveredAt      DateTime?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // Relations
  order          Order  @relation(fields: [orderId], references: [id])
  deliveryPerson User?  @relation(fields: [deliveryPersonId], references: [id])
  waypoints     DeliveryWaypoint[]
}

model Transaction {
  id          String            @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Float
  status      TransactionStatus @default(PENDING)
  orderId     String?
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  // Relations
  user  User   @relation(fields: [userId], references: [id])
  order Order? @relation(fields: [orderId], references: [id])
}

model Wallet {
  id               String   @id @default(cuid())
  sellerId         String   @unique
  balance          Float    @default(0)
  totalEarnings    Float    @default(0)
  totalWithdrawn   Float    @default(0)
  pendingClearance Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  seller Seller @relation(fields: [sellerId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType @default(SYSTEM)
  isRead    Boolean          @default(false)
  data      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id])
}

model Review {
  id          String   @id @default(uuid())
  productId   String
  userId      String
  userName    String
  rating      Int
  title       String?
  comment     String
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([userId])
}

model ReturnRequest {
  id              String         @id @default(uuid())
  returnNumber    String         @unique
  orderId         String
  orderItemId     String         @unique
  buyerId         String
  sellerId        String
  reason          String
  description     String?
  status          ReturnStatus   @default(PENDING)
  refundAmount    Float
  refundStatus    RefundStatus   @default(PENDING)
  resolvedAt      DateTime?
  adminNotes      String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  order           Order          @relation(fields: [orderId], references: [id])
  orderItem       OrderItem      @relation(fields: [orderItemId], references: [id])
  buyer           User           @relation("BuyerReturns", fields: [buyerId], references: [id])
  seller          User           @relation("SellerReturns", fields: [sellerId], references: [id])

  @@index([orderId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model HeroSlide {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  ctaText   String
  ctaLink   String?
  image     String
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Coupon {
  id                  String        @id @default(uuid())
  code                String        @unique
  type                CouponType    @default(PERCENTAGE)
  value               Float
  minOrderValue       Float?
  maxDiscount         Float?
  usageLimit          Int?
  usageCount          Int           @default(0)
  perUserLimit        Int           @default(1)
  validFrom           DateTime?
  validUntil          DateTime?
  isActive            Boolean       @default(true)
  applicableCategories String?
  description         String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  usedCoupons         UsedCoupon[]
}

model UsedCoupon {
  id          String   @id @default(uuid())
  couponId    String
  userId      String
  orderId     String?
  usedAt      DateTime @default(now())

  coupon      Coupon   @relation(fields: [couponId], references: [id])
  user        User     @relation("UsedCoupons", fields: [userId], references: [id])

  @@unique([couponId, userId])
}

model BlogPost {
  id          String     @id @default(uuid())
  title       String
  slug        String     @unique
  excerpt     String?
  content     String
  coverImage  String?
  author      String
  tags        String?
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([status])
}

model Address {
  id          String   @id @default(uuid())
  userId      String
  label       String
  fullName    String
  phone       String
  county      String
  city        String?
  addressLine String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation("UserAddresses", fields: [userId], references: [id])

  @@index([userId])
}

// ============================================================
// Phase 5: Warehouse & Inventory
// ============================================================

model Warehouse {
  id          String           @id @default(uuid())
  name        String
  code        String           @unique
  address     String
  city        String
  county      String
  latitude    Float?
  longitude   Float?
  status      WarehouseStatus @default(ACTIVE)
  capacity    Int              @default(1000)
  managerName String?
  managerPhone String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  inventoryItems  InventoryItem[]
  transferFrom    StockTransfer[] @relation("TransferFrom")
  transferTo      StockTransfer[] @relation("TransferTo")
}

model InventoryItem {
  id              String   @id @default(uuid())
  productId       String
  warehouseId     String
  quantity        Int      @default(0)
  reservedQuantity Int     @default(0)
  reorderLevel    Int      @default(10)
  binLocation     String?
  lastRestocked   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@index([productId])
}

model StockTransfer {
  id              String              @id @default(uuid())
  transferNumber  String              @unique
  productId       String
  fromWarehouseId String
  toWarehouseId   String
  quantity        Int
  status          StockTransferStatus @default(PENDING)
  requestedBy     String?
  approvedBy      String?
  notes           String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  product      Product   @relation(fields: [productId], references: [id])
  fromWarehouse Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])

  @@index([status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

// ============================================================
// Phase 5: Promotions - Flash Sales
// ============================================================

model FlashSale {
  id               String   @id @default(uuid())
  name             String
  productId        String
  discountPercentage Float
  originalPrice    Float
  salePrice        Float
  startTime        DateTime
  endTime          DateTime
  isActive         Boolean  @default(true)
  totalStock       Int
  soldCount        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@index([isActive, startTime])
  @@index([productId])
}

// ============================================================
// Phase 5: CMS - Banners
// ============================================================

model Banner {
  id          String         @id @default(uuid())
  title       String
  image       String
  link        String?
  position    BannerPosition @default(HERO)
  order       Int            @default(0)
  active      Boolean        @default(true)
  clicksCount Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([position, active])
}

// ============================================================
// Phase 5: Delivery Tracking - GPS waypoints
// ============================================================

model DeliveryWaypoint {
  id         String   @id @default(uuid())
  deliveryId String
  latitude   Float
  longitude  Float
  speed      Float?
  heading    Float?
  timestamp  DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, timestamp])
}

// ============================================================
// Audit Logging
// ============================================================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  role      String?
  action    String
  resource  String
  resourceId String?
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

// ============================================================
// Phase: B2B Commerce - Company Accounts
// ============================================================

model Company {
  id            String   @id @default(uuid())
  name          String
  registrationNo String?
  email         String
  phone         String?
  county        String
  city          String?
  address       String?
  logo          String?
  creditLimit   Float    @default(0)
  creditUsed    Float    @default(0)
  paymentTerms  String   @default("NET_30")
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User     @relation("CompanyAccount", fields: [id], references: [id])
  orders Order[]

  @@index([name])
}
